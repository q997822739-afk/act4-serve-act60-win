<Application x:Class="A4Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:A4Launcher.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 配色沿用原版启动器：金色描边 + 深石色面板 -->
            <SolidColorBrush x:Key="Gold"       Color="#F0D68A" />
            <SolidColorBrush x:Key="GoldDark"   Color="#8A6420" />
            <SolidColorBrush x:Key="TextPrimary" Color="#F2F4F8" />
            <SolidColorBrush x:Key="TextSecondary" Color="#AEB7C6" />
            <SolidColorBrush x:Key="TextDim"    Color="#8A93A3" />
            <SolidColorBrush x:Key="OkFg"       Color="#7BE08F" />
            <SolidColorBrush x:Key="BadFg"      Color="#FF8A6B" />
            <SolidColorBrush x:Key="WarnFg"     Color="#FFD27A" />
            <SolidColorBrush x:Key="FieldLine"  Color="#7A5A22" />
            <SolidColorBrush x:Key="ArtNoteFg"  Color="#DCCDAA" />

            <LinearGradientBrush x:Key="GoldText" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF0BE" Offset="0" />
                <GradientStop Color="#E8B84B" Offset="0.5" />
                <GradientStop Color="#B8802A" Offset="1" />
            </LinearGradientBrush>

            <!-- 三态图片按钮：图片自己带边框和底纹，模板只放一张 Image -->
            <Style TargetType="{x:Type controls:ImageButton}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:ImageButton}">
                            <Grid>
                                <Image x:Name="Img" Source="{TemplateBinding NormalImage}" Stretch="Fill" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Img" Property="Source" Value="{Binding HoverImage, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Img" Property="Source" Value="{Binding PressedImage, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 登录页的输入框完全透明地盖在原版画好的黑格子上，只负责让玩家能打字 -->
            <Style x:Key="ArtTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="2,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="#EBD02B" />
                <Setter Property="CaretBrush" Value="#EBD02B" />
                <Setter Property="SelectionBrush" Value="#66E8B84B" />
                <Setter Property="FontFamily" Value="SimSun" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ArtPasswordBox" TargetType="PasswordBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="2,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="#EBD02B" />
                <Setter Property="CaretBrush" Value="#EBD02B" />
                <Setter Property="FontFamily" Value="SimSun" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 原图里输入框是画在背景上的黑底格子，这里只放一个透明输入框盖在上面 -->
            <Style x:Key="LoginTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#FF070604" />
                <Setter Property="BorderBrush" Value="#8A6A30" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="3,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
                <Setter Property="SelectionBrush" Value="#66E8B84B" />
                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
                <Setter Property="Background" Value="#FF070604" />
                <Setter Property="BorderBrush" Value="#8A6A30" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="3,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 登录框右下角的小按钮（注册 / 改密）：小金框 + 金字，跟面板一个风格 -->
            <Style x:Key="PanelLinkButton" TargetType="Button">
                <Setter Property="Height" Value="16" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#E8C87A" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#F0161009" BorderBrush="#8A6A30"
                                    BorderThickness="1" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#40E8B84B" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="#E8B84B" />
                                    <Setter Property="Foreground" Value="#FFF0BE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 记住密码：背景上的方框是自己画的，勾选后打金色对勾 -->
            <Style x:Key="GoldCheckBox" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="#D9C48C" />
                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="13" Height="13" Margin="0,0,6,0"
                                        Background="#FF0A0A08" BorderBrush="#8A6A30" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Tick" Text="✓" FontSize="11" Foreground="#FFE9B44C"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" Margin="0,-2,0,0" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#E8B84B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 第二页的列表：一行就是原版那张 89×22 的牌子（素材直接从 DNFLauncher 进程里拆的），
                 常态 / 悬停 / 选中各一张图，名字用原版的黄字压在牌子上，牌子是什么颜色由状态决定 -->
            <Style x:Key="GameListBox" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- 行距 24 = 牌子 22 + 下面留 2px，让牌子的黑边不贴在一起 -->
                                        <Grid Width="89" Height="22" Margin="0,0,0,2" ClipToBounds="True">
                                            <Image x:Name="Plate" Source="{Binding NormalImage}" Stretch="Fill"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <TextBlock x:Name="Label" Text="{Binding Name}"
                                                       Foreground="{Binding TextBrush}"
                                                       HorizontalAlignment="{Binding TextAlign}"
                                                       Margin="{Binding TextMargin}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="SimSun" FontSize="12"
                                                       TextOptions.TextFormattingMode="Display" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Plate" Property="Source" Value="{Binding HoverImage}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Plate" Property="Source" Value="{Binding SelectedImage}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 对话框（注册 / 改密 / 询问）：全部用原版像素拼，不另画一套 =====
                 金框：bg_login 上「QQ号码」那块登录面板的边，逐像素取色——
                 外暗 #2D1E0B / 亮金 #D08F3E / 中金 #744D1D / 内暗 #080502，各 1px。
                 底：dlg_bg.png（从同一张图的深石板上裁的）平铺。 -->
            <Style x:Key="ArtFrame" TargetType="ContentControl">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="#2D1E0B" Padding="1">
                                <Border Background="#D08F3E" Padding="1">
                                    <Border Background="#744D1D" Padding="1">
                                        <Border Background="#080502" Padding="1">
                                            <Grid Background="#FF1E1910">
                                                <Border>
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="pack://application:,,,/A4Launcher;component/Assets/dlg_bg.png"
                                                                    TileMode="Tile" Viewport="0,0,158,92" ViewportUnits="Absolute" />
                                                    </Border.Background>
                                                </Border>
                                                <ContentPresenter />
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 标题条的字：照原版「第一步：选择大区」的橙金渐变。
                 条本身是 Assets/title_strip.png（tools/make_title_strip.py 从 bg_servers 裁的，去掉了字） -->
            <LinearGradientBrush x:Key="StripText" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFC865" Offset="0" />
                <GradientStop Color="#FFF27F2C" Offset="1" />
            </LinearGradientBrush>

            <!-- 「QQ号码」那种金色粗宋体标签 -->
            <Style x:Key="ArtLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="SimSun" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource GoldText}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <!-- 「游戏协议和玩家条例」那种米色小字 -->
            <Style x:Key="ArtNote" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="SimSun" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource ArtNoteFg}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <!-- 原版登录面板的黑格子：黑底，上/左边 #493629、下/右边 #8A6D5A（凹进去），黄字宋体 12 -->
            <Style x:Key="SlotTextBox" TargetType="TextBox" BasedOn="{StaticResource ArtTextBox}">
                <Setter Property="Height" Value="19" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="Black" BorderBrush="#493629" BorderThickness="1,1,0,0">
                                <Border BorderBrush="#8A6D5A" BorderThickness="0,0,1,1">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SlotPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource ArtPasswordBox}">
                <Setter Property="Height" Value="19" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="Black" BorderBrush="#493629" BorderThickness="1,1,0,0">
                                <Border BorderBrush="#8A6D5A" BorderThickness="0,0,1,1">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 按钮：原版 89×22 牌子图三态（和大区列表同一套），原尺寸不拉伸，压黄字 -->
            <Style x:Key="PlateButton" TargetType="Button">
                <Setter Property="Width" Value="89" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="SimSun" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#EBD02B" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image x:Name="plate" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Source="pack://application:,,,/A4Launcher;component/Assets/item_region_a.png" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="plate" Property="Source"
                                            Value="pack://application:,,,/A4Launcher;component/Assets/item_region_b.png" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="plate" Property="Source"
                                            Value="pack://application:,,,/A4Launcher;component/Assets/item_region_c.png" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#EE1B1710" />
                <Setter Property="Foreground" Value="#EAD7A2" />
                <Setter Property="BorderBrush" Value="#8A6A30" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
