<Window x:Class="A4ServerConsole.Windows.LauncherBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="制作配套登录器"
        Width="720" Height="490" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgRoot}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="制作配套登录器" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="TxtModeBanner" Foreground="{StaticResource AccentGold}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="生成位置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutputDir" AutomationProperties.Name="生成位置" />
                            <Button Grid.Column="1" Content="选择文件夹…" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="BtnBrowseOut_Click" />
                        </Grid>
                        <TextBlock Text="留空时生成到控制台旁的「配套登录器」文件夹；已设置完整客户端时会预填客户端目录。只写入这一个位置，不生成 ZIP。"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 区服显示配置 -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="首页大区名：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtRegion" Margin="0,4,12,4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="服务器名称：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtServerName" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="电信大区列表：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtTelecom" Margin="0,4,12,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="网通大区列表：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtNetcom" Margin="0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="服务器列表：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtServerList" Margin="0,4,12,4" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="服务器状态：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <ComboBox Grid.Row="2" Grid.Column="3" x:Name="CmbState" Margin="0,4">
                            <ComboBoxItem Content="空闲" />
                            <ComboBoxItem Content="繁忙" />
                            <ComboBoxItem Content="拥挤" />
                            <ComboBoxItem Content="维护" />
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="官网链接(可选)：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtWebsite" Margin="0,4,12,4" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="客服链接(可选)：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <TextBox Grid.Row="3" Grid.Column="3" x:Name="TxtService" Margin="0,4" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="打开输出目录" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="BtnOpenOut_Click" />
            <Button Grid.Column="1" Content="制作配套登录器" Style="{StaticResource PrimaryGoldButton}" Margin="0,0,10,0" Click="BtnBuild_Click" />
            <Button Grid.Column="2" Content="关闭" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click" />
        </Grid>
    </Grid>
</Window>
