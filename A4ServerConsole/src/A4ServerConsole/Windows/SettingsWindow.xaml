<Window x:Class="A4ServerConsole.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="路径与端口设置" Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgRoot}" Foreground="{StaticResource TextPrimary}">
    <StackPanel Margin="18">
        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="服务端 JAR：" Target="{Binding ElementName=TxtServerJar}" Foreground="{StaticResource TextSecondary}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtServerJar" Margin="0,3,8,3" />
                <Button Grid.Row="0" Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="0,3" Click="BrowseJar_Click" />
                <Label Grid.Row="1" Content="客户端目录：" Target="{Binding ElementName=TxtClientDir}" Foreground="{StaticResource TextSecondary}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtClientDir" Margin="0,3,8,3" />
                <Button Grid.Row="1" Grid.Column="2" Content="选择" Style="{StaticResource SecondaryButton}" Margin="0,3" Click="BrowseClient_Click" />
                <Label Grid.Row="2" Content="游戏数据库：" Target="{Binding ElementName=TxtDbPath}" Foreground="{StaticResource TextSecondary}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDbPath" Margin="0,3,8,3" />
                <Button Grid.Row="2" Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="0,3" Click="BrowseDb_Click" />
                <Label Grid.Row="3" Content="Java 路径：" Target="{Binding ElementName=TxtJavaExe}" Foreground="{StaticResource TextSecondary}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtJavaExe" Margin="0,3,8,3" />
                <Button Grid.Row="3" Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="0,3" Click="BrowseJava_Click" />
                <TextBlock Grid.Row="4" Text="端口配置：" Margin="5,12,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Label Content="入口" Target="{Binding ElementName=TxtEntrancePort}" Foreground="{StaticResource TextSecondary}" />
                    <TextBox Width="60" x:Name="TxtEntrancePort" />
                    <Label Content="游戏" Target="{Binding ElementName=TxtGamePort}" Foreground="{StaticResource TextSecondary}" />
                    <TextBox Width="60" x:Name="TxtGamePort" />
                    <Label Content="网关" Target="{Binding ElementName=TxtGatewayPort}" Foreground="{StaticResource TextSecondary}" />
                    <TextBox Width="60" x:Name="TxtGatewayPort" />
                    <Label Content="网页 GM" Target="{Binding ElementName=TxtGmPort}" Foreground="{StaticResource TextSecondary}" />
                    <TextBox Width="60" x:Name="TxtGmPort" />
                </WrapPanel>
                <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ChkTokenMode" Content="令牌登录模式（配套登录器）"
                          Margin="0,12,0,0" Foreground="{StaticResource TextPrimary}" />
            </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Content="保存设置" IsDefault="True" Style="{StaticResource PrimaryGoldButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
