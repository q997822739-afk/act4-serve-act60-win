<Window x:Class="A4Launcher.Dialogs.ArtMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:A4Launcher.Controls"
        Title="提示" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" UseLayoutRounding="True" Topmost="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="SimSun">
    <!-- 和注册框同一套原版素材（App.xaml 的 ArtFrame / PlateButton），代替系统 MessageBox -->
    <ContentControl Style="{StaticResource ArtFrame}">
        <StackPanel>
            <Grid Height="25" ClipToBounds="True" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Image Source="../Assets/title_strip.png" Stretch="None" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="TitleText" Margin="12,0,0,0" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource StripText}" VerticalAlignment="Center" />
                <controls:ImageButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,4,0" Width="21" Height="20"
                                      NormalImage="../Assets/close_a.png" HoverImage="../Assets/close_b.png"
                                      PressedImage="../Assets/close_c.png" Click="Cancel_Click" ToolTip="关闭" />
            </Grid>

            <TextBlock x:Name="BodyText" Margin="18,16,18,0" MinHeight="32" TextWrapping="Wrap"
                       LineHeight="18" Style="{StaticResource ArtNote}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,12">
                <Button x:Name="OkButton" Content="确　定" Style="{StaticResource PlateButton}"
                        IsDefault="True" Click="Ok_Click" />
                <Button x:Name="CancelButton" Content="取　消" Style="{StaticResource PlateButton}"
                        Margin="12,0,0,0" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </ContentControl>
</Window>
