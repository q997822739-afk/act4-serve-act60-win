<Window x:Class="A4Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:A4Launcher.Controls"
        Title="地下城与勇士" Icon="appicon.ico" Width="640" Height="497"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei">

    <!-- 640×497 是原版启动器的窗口尺寸，两张背景图本身就是这个大小，坐标全部按像素摆 -->
    <Canvas x:Name="Root" Width="640" Height="497" Background="Transparent"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">

        <!-- ============ 第一页：登录 ============ -->
        <Canvas x:Name="PageLogin" Width="640" Height="497">
            <Image Source="Assets/bg_login.png" Width="640" Height="497"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- 关闭：用原版 exe 里那三张 X 图（常态 / 悬停 / 按下），正好落在背景图上那个凹槽里 -->
            <controls:ImageButton x:Name="BtnClose" Canvas.Left="605" Canvas.Top="55" Width="21" Height="20"
                                  NormalImage="Assets/close_a.png" HoverImage="Assets/close_b.png"
                                  PressedImage="Assets/close_c.png" Click="Close_Click" ToolTip="退出" />

            <!-- 顶部导航 -->
            <controls:ImageButton x:Name="BtnSignup" Canvas.Left="26" Canvas.Top="84" Width="70" Height="21"
                                  NormalImage="Assets/nav_signup_a.png" HoverImage="Assets/nav_signup_b.png"
                                  PressedImage="Assets/nav_signup_c.png" Click="RegisterButton_Click" />
            <controls:ImageButton x:Name="BtnWebsite" Canvas.Left="105" Canvas.Top="84" Width="70" Height="21"
                                  NormalImage="Assets/nav_website_a.png" HoverImage="Assets/nav_website_b.png"
                                  PressedImage="Assets/nav_website_c.png" Click="WebsiteButton_Click" />
            <controls:ImageButton x:Name="BtnHelper" Canvas.Left="184" Canvas.Top="84" Width="70" Height="21"
                                  NormalImage="Assets/nav_helper_a.png" HoverImage="Assets/nav_helper_b.png"
                                  PressedImage="Assets/nav_helper_c.png" Click="HelperButton_Click" />
            <controls:ImageButton x:Name="BtnShop" Canvas.Left="386" Canvas.Top="84" Width="70" Height="21"
                                  NormalImage="Assets/nav_shop_a.png" HoverImage="Assets/nav_shop_b.png"
                                  PressedImage="Assets/nav_shop_c.png" Click="ShopButton_Click" />
            <controls:ImageButton x:Name="BtnForum" Canvas.Left="465" Canvas.Top="84" Width="70" Height="21"
                                  NormalImage="Assets/nav_forum_a.png" HoverImage="Assets/nav_forum_b.png"
                                  PressedImage="Assets/nav_forum_c.png" Click="ForumButton_Click" />
            <controls:ImageButton x:Name="BtnService" Canvas.Left="544" Canvas.Top="84" Width="70" Height="21"
                                  NormalImage="Assets/nav_service_a.png" HoverImage="Assets/nav_service_b.png"
                                  PressedImage="Assets/nav_service_c.png" Click="ServiceButton_Click" />

            <!-- 登录框：原版 bg_login 上已经画好了「QQ号码 / QQ密码 / 已阅读并同意…」，
                 这里只在它的黑框位置叠一个透明输入框，勾选位置叠一个红勾，一个像素都不挪 -->
            <TextBox x:Name="AccountBox" Canvas.Left="268" Canvas.Top="347" Width="168" Height="17"
                     Style="{StaticResource ArtTextBox}" MaxLength="10" />
            <PasswordBox x:Name="PasswordBox" Canvas.Left="268" Canvas.Top="370" Width="168" Height="17"
                         Style="{StaticResource ArtPasswordBox}" MaxLength="16" />

            <!-- 协议勾选：这个勾同时也是「记住密码」（默认勾上、默认记住） -->
            <Border x:Name="AgreeHit" Canvas.Left="245" Canvas.Top="388" Width="20" Height="20"
                    Background="Transparent" Cursor="Hand" ToolTip="记住账号密码"
                    MouseLeftButtonDown="Agree_Click" />
            <Image x:Name="AgreeTick" Canvas.Left="247" Canvas.Top="390" Width="15" Height="15"
                   Source="Assets/check_on.png" IsHitTestVisible="False" />

            <!-- 出错 / 启动提示。原版没这块，只在有话说的时候浮出来，平时完全看不见 -->
            <Border x:Name="StatusPanel" Canvas.Left="190" Canvas.Top="300" Width="280" Height="22"
                    Background="#D4120D08" BorderBrush="#8A6A30" BorderThickness="1" CornerRadius="2"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Margin="6,0" VerticalAlignment="Center" FontSize="11"
                           FontFamily="Microsoft YaHei" Foreground="{StaticResource BadFg}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Border>

            <!-- 公告跑马灯：压在原图那条「适度游戏益脑」上，没有公告时整条隐藏 -->
            <!-- 公告：正好压在原图那条深棕色带子上（11..628 × 432..449），不再盖住左右两侧的金边框 -->
            <Border x:Name="TickerBar" Canvas.Left="11" Canvas.Top="432" Width="618" Height="18"
                    Background="Transparent" Visibility="Collapsed">
                <Canvas ClipToBounds="True">
                    <TextBlock x:Name="TickerText" Canvas.Top="1" FontSize="11" Foreground="#E8C87A" />
                </Canvas>
            </Border>

            <!-- 两个大按钮 -->
            <controls:ImageButton x:Name="BtnSelectServer" Canvas.Left="38" Canvas.Top="348" Width="116" Height="77"
                                  NormalImage="Assets/btn_selserver_a.png" HoverImage="Assets/btn_selserver_b.png"
                                  PressedImage="Assets/btn_selserver_c.png" Click="SelectServer_Click" />
            <controls:ImageButton x:Name="PlayButton" Canvas.Left="486" Canvas.Top="348" Width="116" Height="77"
                                  NormalImage="Assets/btn_enter_a.png" HoverImage="Assets/btn_enter_b.png"
                                  PressedImage="Assets/btn_enter_c.png" Click="PlayButton_Click" />
        </Canvas>

        <!-- ============ 第二页：选大区 / 服务器 ============ -->
        <Canvas x:Name="PageServers" Width="640" Height="497" Visibility="Collapsed">
            <Image Source="Assets/bg_servers.png" Width="640" Height="497"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <controls:ImageButton x:Name="BtnClose2" Canvas.Left="605" Canvas.Top="55" Width="21" Height="20"
                                  NormalImage="Assets/close_a.png" HoverImage="Assets/close_b.png"
                                  PressedImage="Assets/close_c.png" Click="Close_Click" ToolTip="退出" />

            <!-- 左侧「电信 / 网通 / 服务器」三个竖标签是画在背景图里的（带光晕），
                 这里只盖透明点击区；原图两个分类标签长得一模一样，所以不加高亮，靠右边的列表内容区分 -->
            <Border x:Name="TabTelecom" Canvas.Left="30" Canvas.Top="132" Width="30" Height="52"
                    Background="Transparent" Cursor="Hand" ToolTip="电信大区"
                    MouseLeftButtonDown="Telecom_Click" />
            <Border x:Name="TabNetcom" Canvas.Left="30" Canvas.Top="212" Width="30" Height="50"
                    Background="Transparent" Cursor="Hand" ToolTip="网通大区"
                    MouseLeftButtonDown="Netcom_Click" />

            <!-- 第一步：大区列表。第一块牌子的左上角在原版里正好落在 (82,129)，一行 89×22、行距 24 -->
            <ListBox x:Name="RegionList" Canvas.Left="82" Canvas.Top="129" Width="89" Height="144"
                     Style="{StaticResource GameListBox}" SelectionChanged="RegionList_SelectionChanged" />

            <!-- 第二步：服务器列表，第一块牌子在原版里落在 (82,334)，面板到 y=410，正好三行 -->
            <ListBox x:Name="ServerList" Canvas.Left="82" Canvas.Top="334" Width="89" Height="72"
                     Style="{StaticResource GameListBox}" SelectionChanged="ServerList_SelectionChanged" />

            <!-- 当前：黑底框是背景图里画好的（258..404 × 449..465），只往里写名字 -->
            <StackPanel x:Name="CurrentPanel" Canvas.Left="268" Canvas.Top="449" Height="17"
                        Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentName" FontFamily="SimSun" FontSize="12" Foreground="#EBD02B"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CurrentState" Text=" （已连接）" FontFamily="SimSun" FontSize="12"
                           Foreground="#B9B9B9" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 全屏显示游戏：方框和文字都在背景图上，这里只做勾选状态 + 点击区 -->
            <Border x:Name="FullscreenHit" Canvas.Left="524" Canvas.Top="85" Width="112" Height="20"
                    Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Fullscreen_Click" />
            <Border x:Name="FullscreenBox" Canvas.Left="527" Canvas.Top="87" Width="12" Height="12"
                    BorderBrush="#D5A866" BorderThickness="1" Background="#FF000000"
                    IsHitTestVisible="False">
                <TextBlock x:Name="FullscreenTick" Text="✓" FontSize="9" Foreground="#FFE9B44C"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"
                           Visibility="Collapsed" />
            </Border>

            <controls:ImageButton x:Name="BtnConfirm" Canvas.Left="475" Canvas.Top="438" Width="110" Height="40"
                                  NormalImage="Assets/btn_ok_a.png" HoverImage="Assets/btn_ok_b.png"
                                  PressedImage="Assets/btn_ok_c.png" Click="ConfirmServer_Click" />
            <controls:ImageButton x:Name="BtnQuit" Canvas.Left="56" Canvas.Top="438" Width="110" Height="40"
                                  NormalImage="Assets/btn_quit_a.png" HoverImage="Assets/btn_quit_b.png"
                                  PressedImage="Assets/btn_quit_c.png" Click="Close_Click" />
        </Canvas>
    </Canvas>
</Window>
