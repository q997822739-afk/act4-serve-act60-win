<Window x:Class="A4ServerConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A4 游戏服务器控制台"
        Width="960" Height="640"
        MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgRoot}"
        Foreground="{StaticResource TextPrimary}"
        Closing="Window_Closing">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：仿参考图主控制面板 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题区 -->
            <Grid Grid.Row="0" Margin="0,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="A4 游戏服务器控制台" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="制作配套登录器" Style="{StaticResource PrimaryGoldButton}"
                        Margin="12,0,0,0" Click="BtnLauncherBuilder_Click" />
            </Grid>

            <!-- 卡片内容区 -->
            <DockPanel Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              DockPanel.Dock="Right">
                    <StackPanel>
                    <!-- 卡片 1：单机 / 公网模式 -->
                    <Border Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,12,12">
                        <StackPanel>
                            <RadioButton x:Name="RbLocalMode"
                                         GroupName="ServerMode"
                                         Content="本机模式 (127.0.0.1)"
                                         Foreground="{StaticResource TextPrimary}"
                                         FontSize="14" FontWeight="SemiBold"
                                         Checked="ModeRadio_Changed" />

                            <RadioButton x:Name="RbPublicMode"
                                         GroupName="ServerMode"
                                         Content="公网模式 (自定义 IP)"
                                         Foreground="{StaticResource TextPrimary}"
                                         FontSize="14" FontWeight="SemiBold"
                                         Margin="0,10,0,0"
                                         Checked="ModeRadio_Changed" />

                            <Grid Margin="22,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="公网 IP：" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtPublicIp" TextChanged="AnyConfig_Changed" />
                                <Button Grid.Column="2" x:Name="BtnDetectIp" Content="自动识别"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        Padding="12,5" Click="BtnDetectIp_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 2：登录器网关 -->
                    <Border Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,12,12">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableGateway"
                                      Content="同时启动登录器网关"
                                      Foreground="{StaticResource TextPrimary}"
                                      FontSize="13.5" FontWeight="SemiBold"
                                      Checked="AnyConfig_Changed" Unchecked="AnyConfig_Changed" />
                            <CheckBox x:Name="ChkEnableGm" Content="同时启动网页 GM 工具"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"
                                      FontSize="13.5" FontWeight="SemiBold"
                                      Checked="AnyConfig_Changed" Unchecked="AnyConfig_Changed" />
                            <Grid Margin="22,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="GM 密码：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtGmPassword" MaxLength="128" Padding="6,4"
                                         AutomationProperties.Name="GM 密码" />
                                <TextBlock Grid.Row="1" Text="GM 地址：" Margin="0,8,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtGmUrl" IsReadOnly="True" Margin="0,8,0,0" AutomationProperties.Name="GM 地址" />
                                <Button Grid.Row="1" Grid.Column="2" Content="复制地址" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" Margin="8,8,0,0" Click="BtnCopyGmUrl_Click" />
                            </Grid>
                            <TextBlock x:Name="TxtGmHint" Margin="22,6,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,0,12,8">
                        <Button Content="存档备份管理…" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="BtnBackupManager_Click" />
                        <Button Content="路径与端口设置…" x:Name="BtnSettings" Style="{StaticResource SecondaryButton}"
                                Click="BtnSettings_Click" />
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- 底部启动/停止与状态区 -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnStart" Content="启动服务器"
                            Style="{StaticResource PrimaryGoldButton}" Click="BtnStart_Click" />
                    <Button Grid.Column="2" x:Name="BtnStop" Content="停止"
                            Style="{StaticResource DangerStopButton}" IsEnabled="False" Click="BtnStop_Click" />
                    <Button Grid.Column="4" x:Name="BtnOpenGm" Content="打开 GM 网页"
                            Style="{StaticResource SecondaryButton}" Click="BtnOpenGm_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMuted}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtStatus" Text="服务器已停止" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 右侧：实时运行日志面板 -->
        <Border Grid.Column="2" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="实时运行日志（游戏服 / 登录器网关）"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="清空日志" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12"
                            Click="BtnClearLog_Click" />
                </Grid>

                <TextBox Grid.Row="1" x:Name="TxtLog"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="#0F131B"
                         Foreground="#D5DFEE" />
            </Grid>
        </Border>
    </Grid>
</Window>
