<Window x:Class="A4ServerConsole.Windows.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存档备份管理"
        Width="680" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgRoot}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="角色存档备份管理" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="TxtDbPath" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="立即备份存档" Style="{StaticResource PrimaryGoldButton}" Padding="14,7" FontSize="13" Click="BtnBackupNow_Click" />
            <Button Content="恢复选中备份" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BtnRestore_Click" />
            <Button Content="删除选中" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BtnDelete_Click" />
            <Button Content="打开备份目录" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BtnOpenDir_Click" />
            <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BtnRefresh_Click" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="ListBackups"
                      Background="Transparent"
                      Foreground="{StaticResource TextPrimary}"
                      BorderThickness="0"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="备份文件名" Width="340" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="备份时间" Width="160" DisplayMemberBinding="{Binding CreatedAtText}" />
                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource TextMuted}" FontSize="12"
                   Text="提示：恢复存档前请先停止游戏服与登录器网关；恢复时会自动先创建一份 before_restore 安全快照。" />
    </Grid>
</Window>
