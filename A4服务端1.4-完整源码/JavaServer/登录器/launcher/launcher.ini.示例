[game]
; 留空 = 用网关登录时返回的地址
host =
port = 7001

[login]
; 大区名，逗号分隔可以写多个
region = 华南区 / 广东一区
; 服务器列表里显示的名字，留空 = 显示游戏地址
server =
; 服务器状态：空闲 / 繁忙 / 拥挤 / 维护
server_state = 空闲

[links]
; 顶部导航按钮打开哪个网页，留空就提示"还没配"
website =
helper =
shop =
forum =
service =

[regions]
; 第二页「第一步」的两个大区分类，逗号分隔；每项可以写成 名字|状态
; 状态有 空闲 / 繁忙 / 拥挤 / 维护 四种（只影响显示的颜色）
telecom = 华南区
netcom = 华南区

[servers]
; 第二页「第二步」的服务器列表，选哪个大区都一样（私服一般就一台服）
; 想要真实点可以写：服务器1|空闲,服务器2|繁忙,服务器3|维护
list = 广东一区
